<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>CS9057</WarningsAsErrors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Mortz.Tests\**" />
    <Compile Remove="Mortz.E2E.Tests\**" />
    <Compile Remove="Mortz.E2E.Protocol\**" />
    <Compile Remove="Mortz.Content\**" />
    <Compile Remove="Mortz.Core\**" />
    <Compile Remove="Mortz.Server\**" />
    <Compile Remove="Mortz.Net.Gen\**" />
    <Compile Remove="tools\**" />
    <Compile Remove="build\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Mortz.Core\Mortz.Core.csproj" />
    <ProjectReference Include="Mortz.Content\Mortz.Content.csproj" />
    <ProjectReference Include="Mortz.Server\Mortz.Server.csproj" />
    <!-- Debug only: TOOLS is the E2E gate; this reference must not survive into an export. -->
    <ProjectReference Include="Mortz.E2E.Protocol\Mortz.E2E.Protocol.csproj"
                      Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="Mortz.Net.Gen\Mortz.Net.Gen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Chickensoft.AutoInject" Version="2.13.25" PrivateAssets="all" />
    <PackageReference Include="Chickensoft.GodotNodeInterfaces" Version="3.0.26" />
    <PackageReference Include="Chickensoft.Introspection" Version="3.0.3" />
    <PackageReference Include="Chickensoft.Introspection.Generator" Version="3.0.3" PrivateAssets="all" OutputItemType="analyzer" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
