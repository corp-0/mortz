<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);MZ2004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mortz.Core/Mortz.Core.csproj" />
    <ProjectReference Include="../Mortz.Protocol/Mortz.Protocol.csproj" />
    <ProjectReference Include="../Mortz.Client/Mortz.Client.csproj" />
    <ProjectReference Include="../Mortz.Server/Mortz.Server.csproj" />
    <ProjectReference Include="../Mortz.Content/Mortz.Content.csproj" />
    <ProjectReference Include="../Mortz.Net.Gen/Mortz.Net.Gen.csproj" />
    <ProjectReference Include="../Mortz.Net.Gen/Mortz.Net.Gen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../Mortz.Tests/Client/FakeSessionExit.cs" Link="Client/FakeSessionExit.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
